# =============================================================================
# UAJS Smart Campus - Referencia de variables de entorno
# =============================================================================
# Este archivo resume TODAS las variables que usa el sistema. No se lee
# directamente: cada componente carga su propio `.env` (formato dotenv).
#
# Para crear los `.env` de cada componente a partir de sus `.env.example`:
#     cd backend && npm run setup:env
# (copia solo los que faltan; nunca sobrescribe uno existente)
#
# Los valores de abajo son de DESARROLLO LOCAL e ilustrativos. No son
# credenciales reales. Los `.env` reales estan en .gitignore y no deben
# subirse al repositorio. Para cualquier despliegue real, cambia JWT_SECRET
# y la contraseña de la base de datos.
# =============================================================================

# -----------------------------------------------------------------------------
# Compartidas por todos los microservicios  (backend/services/*/.env)
# -----------------------------------------------------------------------------
# Secreto con el que usuarios-service firma los JWT y con el que cada servicio
# los valida. DEBE ser el mismo en todos los servicios.
JWT_SECRET=uajs_smart_campus_dev_secret_change_me
# Unico origen web que CORS deja pasar (el frontend de desarrollo).
FRONTEND_ORIGIN=http://localhost:5183

# -----------------------------------------------------------------------------
# Base de datos  (docker-compose.yml de backend/ crea el contenedor)
# -----------------------------------------------------------------------------
# Un solo servidor PostgreSQL con una base independiente por microservicio.
# Usuario y clave del contenedor: estan definidos en backend/docker-compose.yml
# (POSTGRES_USER=uajs, POSTGRES_PASSWORD=uajs_dev_pass); no se leen de un .env.
# Cadena de conexion de cada servicio (cada uno apunta SOLO a su base):
#   usuarios-service       DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_usuarios
#   solicitudes-service    DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_solicitudes
#   reservas-service       DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_reservas
#   recursos-service       DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_recursos
#   eventos-service        DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_eventos
#   notificaciones-service DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_notificaciones

# -----------------------------------------------------------------------------
# API Gateway  (backend/gateway/.env)
# -----------------------------------------------------------------------------
# En su .env la variable se llama PORT:
PORT=4000
USUARIOS_SERVICE_URL=http://localhost:4001
SOLICITUDES_SERVICE_URL=http://localhost:4002
RESERVAS_SERVICE_URL=http://localhost:4003
RECURSOS_SERVICE_URL=http://localhost:4004
EVENTOS_SERVICE_URL=http://localhost:4005
NOTIFICACIONES_SERVICE_URL=http://localhost:4006
BUSQUEDA_SERVICE_URL=http://localhost:4007

# -----------------------------------------------------------------------------
# Puertos de los microservicios  (variable PORT de cada servicio)
# -----------------------------------------------------------------------------
#   usuarios 4001 | solicitudes 4002 | reservas 4003 | recursos 4004
#   eventos 4005  | notificaciones 4006 | busqueda 4007

# -----------------------------------------------------------------------------
# Comunicacion entre servicios (HTTP sincrono; ver README, "Integracion")
# -----------------------------------------------------------------------------
#   solicitudes-service  -> USUARIOS_SERVICE_URL   (verifica responsables)
#   reservas-service     -> USUARIOS_SERVICE_URL   (verifica que el usuario este activo)
#   notificaciones-svc   -> USUARIOS_SERVICE_URL   (verifica al destinatario)
#   recursos-service     -> RESERVAS_SERVICE_URL   (sincroniza stock; consulta reservas activas)
#   solicitudes/reservas/recursos/eventos/usuarios -> BUSQUEDA_SERVICE_URL (indexan en Elasticsearch)

# -----------------------------------------------------------------------------
# usuarios-service (extras)
# -----------------------------------------------------------------------------
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5183
# Contraseña de los usuarios de prueba que crea el seed (solo desarrollo).
SEED_PASSWORD=uajs2026
# Correo de recuperacion de contraseña (opcional; sin esto el enlace de
# restablecimiento solo se registra en consola). Usa una "contraseña de
# aplicacion", nunca tu contraseña real.
EMAIL_USER=tu_cuenta@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion_de_16_caracteres

# -----------------------------------------------------------------------------
# busqueda-service (Elasticsearch)
# -----------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# Frontend  (frontend/.env)
# -----------------------------------------------------------------------------
# URL base de la API: SIEMPRE el Gateway, nunca un microservicio ni la base de datos.
VITE_API_URL=http://localhost:4000/api

# -----------------------------------------------------------------------------
# Pruebas automaticas  (backend/tests, opcionales)
# -----------------------------------------------------------------------------
# API_URL=http://localhost:4000/api
