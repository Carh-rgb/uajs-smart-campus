# UAJS Smart Campus — resumen de variables de entorno (valores de ejemplo, NO secretos reales).
# Cada servicio lee su propio .env: copie backend/gateway/.env.example y
# backend/services/<servicio>/.env.example a .env en la misma carpeta.

# --- Comunes a todos los servicios -------------------------------------
# Mismo valor en el gateway y en los 7 servicios. Cambiarlo antes de desplegar.
JWT_SECRET=uajs_smart_campus_dev_secret_change_me
# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5183

# --- Gateway (backend/gateway/.env) -------------------------------------
PORT=4000
USUARIOS_SERVICE_URL=http://localhost:4001
SOLICITUDES_SERVICE_URL=http://localhost:4002
RESERVAS_SERVICE_URL=http://localhost:4003
RECURSOS_SERVICE_URL=http://localhost:4004
EVENTOS_SERVICE_URL=http://localhost:4005
NOTIFICACIONES_SERVICE_URL=http://localhost:4006
BUSQUEDA_SERVICE_URL=http://localhost:4007

# --- Bases de datos (una por servicio, en cada .env) ---------------------
# usuarios-service:       postgres://uajs:uajs_dev_pass@localhost:5432/uajs_usuarios
# solicitudes-service:    postgres://uajs:uajs_dev_pass@localhost:5432/uajs_solicitudes
# reservas-service:       postgres://uajs:uajs_dev_pass@localhost:5432/uajs_reservas
# recursos-service:       postgres://uajs:uajs_dev_pass@localhost:5432/uajs_recursos
# eventos-service:        postgres://uajs:uajs_dev_pass@localhost:5432/uajs_eventos
# notificaciones-service: postgres://uajs:uajs_dev_pass@localhost:5432/uajs_notificaciones
DATABASE_URL=postgres://uajs:uajs_dev_pass@localhost:5432/uajs_usuarios

# --- busqueda-service ----------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200

# --- usuarios-service (recuperacion de contrasena por correo) ------------
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5183
SEED_PASSWORD=uajs2026
EMAIL_USER=tu_cuenta@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion

# --- frontend (frontend/.env) --------------------------------------------
VITE_API_URL=http://localhost:4000/api
